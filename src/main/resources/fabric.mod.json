{
  "schemaVersion": 1,
  "id": "voidboost",
  "version": "${version}",
  "name": "VoidBoost",
  "description": "A lightweight performance optimizer built for smoother Minecraft gameplay, higher FPS, and cleaner PvP rendering.",
  "authors": [
    "VoidFlame"
  ],
  "license": "MIT",
  "environment": "client",
  "icon": "assets/voidboost/icon.png",
  "entrypoints": {
    "client": [
      "com.voidboost.client.VoidBoostClient"
    ]
  },
  "mixins": [
    {
      "config": "voidboost.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.5",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.141.6+1.21.11"
  },
  "custom": {
    "modmenu": {
      "update_checker": false
    }
  }
}
